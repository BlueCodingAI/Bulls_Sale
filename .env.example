# ─────────────────────────────────────────────────────────────────────────
# Rocking C Cattle — environment variables
# Copy this file to ".env.local" for local development, OR add these in your
# hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).
#
# These are OPTIONAL. Without them the contact form still works — it simply
# opens the visitor's email app instead of sending mail in the background.
# To have inquiries delivered straight to your inbox, sign up at resend.com
# (free), verify your domain, and fill these in.
# ─────────────────────────────────────────────────────────────────────────

# Your Resend API key (starts with "re_")
RESEND_API_KEY=

# Where inquiries should be delivered (your email address)
CONTACT_TO=info@rockingccattle.com

# The "from" address — must be a domain you've verified in Resend.
# Until your domain is verified you can use: Rocking C Cattle <onboarding@resend.dev>
CONTACT_FROM=Rocking C Cattle <info@rockingccattle.com>

# ─────────────────────────────────────────────────────────────────────────
# Admin panel (/admin) — manage bulls, photos, and see marketing stats.
# REQUIRED to enable the admin. Without ADMIN_PASSWORD the login page is
# disabled and the public site is unaffected.
# ─────────────────────────────────────────────────────────────────────────

# The password the owner types to sign in at /admin.
ADMIN_PASSWORD=

# A long random string used to sign the login cookie, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Where editable content (bulls.json, images.json, analytics) is stored.
# Defaults to ./content. On a host with an ephemeral disk, point this at a
# PERSISTENT volume (and mount public/uploads there too) so edits survive
# restarts/redeploys.
# CONTENT_DIR=/var/data/rocking-c
